# Myko backend – Garden_Light_DB suora OPC UA (lisää systemd drop-in / myko-backend.service.d/)
# Tuotannossa Lubuntu: FB_LIGHT_OPC_CONNECT=1 kun migrate on ajettu.
# Cloud-agentti / CI: älä aseta CONNECT=1 (ei PLC-yhteyttä).

FB_LIGHT_OPC_CONNECT=1
FB_LIGHT_OPC_ENDPOINT=opc.tcp://192.168.1.103:4840
MYKO_STATE_DIR=/home/atte/.config/myko
